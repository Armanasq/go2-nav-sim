{
  "columns": [
    "Simulator",
    "Perception",
    "Estimation",
    "Navigation",
    "Evaluation"
  ],
  "nodes": [
    {
      "id": "gazebo",
      "col": 0,
      "label": "Gazebo Classic 11",
      "kind": "process",
      "what": "Physics and rendering. Arena generated by make_arena.py; cameras and the GPU lidar render on the NVIDIA GPU when present.",
      "files": [
        "src/go2_nav_sim/launch/sim.launch.py",
        "src/go2_nav_sim/worlds/arena.world",
        "src/go2_nav_sim/scripts/make_arena.py"
      ],
      "chapter": "03-install-and-first-run"
    },
    {
      "id": "champ",
      "col": 0,
      "label": "CHAMP gait controller",
      "kind": "process",
      "what": "Turns /cmd_vel into leg trajectories through ros2_control. Limits: 0.3 m/s forward, 0.25 m/s sideways, 0.5 rad/s yaw. Keeps walking on the last command it received.",
      "files": [
        "patches/upstream.patch"
      ],
      "chapter": "03-install-and-first-run"
    },
    {
      "id": "lidar",
      "col": 0,
      "label": "3D lidar",
      "kind": "sensor",
      "what": "16 beams, ±15°, 900 samples per revolution, 0.3–20 m, 1 cm noise, gpu_ray sensor, mounted 0.10 m above base_link.",
      "topics": [
        {
          "name": "/lidar/points",
          "type": "sensor_msgs/PointCloud2",
          "rate": "10 Hz",
          "frame": "lidar_link"
        }
      ],
      "files": [
        "src/go2_nav_sim/urdf/sensors.xacro"
      ],
      "chapter": "08-robot-and-sensors"
    },
    {
      "id": "camera",
      "col": 0,
      "label": "RGB-D camera",
      "kind": "sensor",
      "what": "640×360, 1.2 rad horizontal FOV, depth 0.3–8 m with 7 mm noise. Images stamped in the optical frame.",
      "topics": [
        {
          "name": "/camera/image_raw",
          "type": "sensor_msgs/Image",
          "rate": "10 Hz",
          "frame": "camera_optical"
        },
        {
          "name": "/camera/depth/image_raw",
          "type": "sensor_msgs/Image (32FC1, m)",
          "rate": "10 Hz",
          "frame": "camera_optical"
        }
      ],
      "files": [
        "src/go2_nav_sim/urdf/sensors.xacro"
      ],
      "chapter": "08-robot-and-sensors"
    },
    {
      "id": "imu",
      "col": 0,
      "label": "IMU",
      "kind": "sensor",
      "what": "From the upstream description; gaussian gyro noise σ = 2e-4 rad/s. Its integrated yaw matched ground truth to 1–2° over 6 s in the recorded runs.",
      "topics": [
        {
          "name": "/imu/data",
          "type": "sensor_msgs/Imu",
          "rate": "100 Hz",
          "frame": "base_link"
        }
      ],
      "chapter": "08-robot-and-sensors"
    },
    {
      "id": "p2l",
      "col": 1,
      "label": "pointcloud_to_laserscan",
      "kind": "process",
      "what": "3D cloud → 2D scan in base_footprint, height band 0.30–0.90 m. That frame sits 0.209 m below the real ground and is not tilt-compensated here (see chapter 9), so the band is about 0.09–0.69 m above the real ground.",
      "topics": [
        {
          "name": "/scan",
          "type": "sensor_msgs/LaserScan",
          "rate": "10 Hz",
          "frame": "base_footprint"
        }
      ],
      "files": [
        "src/go2_nav_sim/config/scan.yaml"
      ],
      "chapter": "10-mapping-and-navigation"
    },
    {
      "id": "lio",
      "col": 2,
      "label": "lidar_odom.py",
      "kind": "process",
      "what": "Planar scan-to-local-map point-to-line ICP. Yaw comes from the tilt-compensated integrated gyro; ICP solves translation with Geman-McClure weights and a prior toward the prediction only along degenerate directions. Publishes its covariance (σ²H⁻¹). Gated at 0.6 m/s and 0.8 rad/s, re-seeds after 8 rejections.",
      "topics": [
        {
          "name": "/lidar_odom",
          "type": "nav_msgs/Odometry",
          "rate": "10 Hz",
          "frame": "odom → base_footprint"
        }
      ],
      "files": [
        "src/go2_nav_sim/scripts/lidar_odom.py"
      ],
      "chapter": "09-state-estimation"
    },
    {
      "id": "ekf",
      "col": 2,
      "label": "EKF (robot_localization)",
      "kind": "process",
      "what": "Fuses x and y from the lidar odometry (with its registration covariance) and the IMU yaw rate, each counted once, in 2D mode, and owns the odom → base_footprint transform.",
      "topics": [
        {
          "name": "/odom",
          "type": "nav_msgs/Odometry",
          "rate": "50 Hz",
          "frame": "odom → base_footprint"
        }
      ],
      "files": [
        "src/go2_nav_sim/config/ekf.yaml"
      ],
      "chapter": "09-state-estimation"
    },
    {
      "id": "amcl",
      "col": 3,
      "label": "AMCL + map_server",
      "kind": "process",
      "what": "Localises against the arena map and publishes map → odom. Started from the true pose by go_to_goal.py, repeated until it converges.",
      "topics": [
        {
          "name": "/amcl_pose",
          "type": "geometry_msgs/PoseWithCovarianceStamped",
          "rate": "on update",
          "frame": "map"
        }
      ],
      "files": [
        "src/go2_nav_sim/config/nav2_params.yaml",
        "src/go2_nav_sim/maps/arena.yaml"
      ],
      "chapter": "10-mapping-and-navigation"
    },
    {
      "id": "nav2",
      "col": 3,
      "label": "Nav2",
      "kind": "process",
      "what": "NavFn (A*) planner, Regulated Pure Pursuit at 0.25 m/s, 0.33 m circular footprint, inflation 0.75 m, velocity smoother at 0.3 m/s and 0.5 rad/s.",
      "topics": [
        {
          "name": "/plan",
          "type": "nav_msgs/Path",
          "rate": "1 Hz replanning",
          "frame": "map"
        },
        {
          "name": "/cmd_vel",
          "type": "geometry_msgs/Twist",
          "rate": "15 Hz",
          "frame": "base_footprint"
        }
      ],
      "files": [
        "src/go2_nav_sim/config/nav2_params.yaml",
        "src/go2_nav_sim/scripts/make_nav2_params.py"
      ],
      "chapter": "10-mapping-and-navigation"
    },
    {
      "id": "slam",
      "col": 3,
      "label": "slam_toolbox (passive)",
      "kind": "process",
      "what": "Builds a map from /scan in its own slam_map frame and never publishes map → odom, so it cannot fight AMCL.",
      "topics": [
        {
          "name": "/slam/map",
          "type": "nav_msgs/OccupancyGrid",
          "rate": "1 Hz",
          "frame": "slam_map"
        }
      ],
      "files": [
        "src/go2_nav_sim/config/slam.yaml"
      ],
      "chapter": "10-mapping-and-navigation"
    },
    {
      "id": "gt",
      "col": 4,
      "label": "Ground truth (p3d)",
      "kind": "sensor",
      "what": "Noise-free simulator pose. Used once by go_to_goal.py to initialise AMCL, then only recorded and used for scoring.",
      "topics": [
        {
          "name": "/odom_gt",
          "type": "nav_msgs/Odometry",
          "rate": "50 Hz",
          "frame": "world (shifted by A)"
        }
      ],
      "files": [
        "src/go2_nav_sim/urdf/sensors.xacro"
      ],
      "chapter": "11-record-and-visualise"
    },
    {
      "id": "bag",
      "col": 4,
      "label": "rosbag2 + metrics",
      "kind": "process",
      "what": "MCAP bag with zstd chunks (~8 MB/s). bag_metrics.py scores odometry and AMCL against ground truth; render_dashboard.py and export_run.py turn the bag into the video and the data on this site.",
      "files": [
        "scripts/record_bag.sh",
        "src/go2_nav_sim/scripts/bag_metrics.py",
        "src/go2_nav_sim/scripts/export_run.py"
      ],
      "chapter": "11-record-and-visualise"
    }
  ],
