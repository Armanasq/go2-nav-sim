    <model name="spectator"><static>1</static><pose>0.0 -11.0 9.5 0 0.735 1.571</pose><link name="l">
      <sensor name="spectator_sensor" type="camera"><always_on>1</always_on><update_rate>10</update_rate>
        <camera><horizontal_fov>1.3</horizontal_fov><image><width>960</width><height>540</height><format>R8G8B8</format></image>
        <clip><near>0.1</near><far>40</far></clip></camera>
        <plugin name="spectator_plugin" filename="libgazebo_ros_camera.so"><ros><namespace>spectator</namespace></ros>
        <camera_name>cam</camera_name><frame_name>spectator_optical</frame_name></plugin><pose>0 0 0 0 0 0</pose></sensor></link></model>
    <!-- stage 8: overhead camera above the 8.10 line (world x -4.5 to -1.5 at y = -3.5); image right = +x, image up = +y -->
    <model name="overhead"><static>1</static><pose>-3.0 -3.3 3.5 0 1.5708 1.5708</pose><link name="l">
      <sensor name="overhead_sensor" type="camera"><always_on>1</always_on><update_rate>10</update_rate>
