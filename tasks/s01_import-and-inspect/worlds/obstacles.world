<?xml version="1.0"?>
<!-- Floor and two static obstacles for task 1.09, built on empty.world: sun, the arena's physics (ODE, 1 ms step) and a ground plane with the arena's friction. -->
<sdf version="1.6"><world name="obstacles">
  <light name="sun" type="directional"><cast_shadows>1</cast_shadows><pose>0 0 10 0 0 0</pose><diffuse>0.8 0.8 0.8 1</diffuse>
    <specular>0.1 0.1 0.1 1</specular><direction>-0.5 0.5 -1</direction></light>
  <gravity>0 0 -9.8</gravity>
  <physics name="default_physics" default="0" type="ode"><max_step_size>0.001</max_step_size>
    <real_time_factor>1</real_time_factor><real_time_update_rate>1000</real_time_update_rate></physics>
  <scene><ambient>0.45 0.45 0.45 1</ambient><background>0.7 0.78 0.9 1</background><shadows>1</shadows></scene>
  <model name="ground_plane"><static>1</static><link name="link">
    <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
      <surface><friction><ode><mu>100</mu><mu2>50</mu2></ode></friction></surface></collision>
    <visual name="visual"><cast_shadows>0</cast_shadows><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
      <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
  </link></model>
  <!-- box: front face at x = -3.0, 1.5 m ahead of the spawn point; cylinder off to the left, not on the path -->
  <model name="box"><static>1</static><pose>-2.8 -3.5 0.25 0 0 0</pose><link name="link">
    <collision name="collision"><geometry><box><size>0.4 1.2 0.5</size></box></geometry></collision>
    <visual name="visual"><geometry><box><size>0.4 1.2 0.5</size></box></geometry>
      <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material></visual>
  </link></model>
  <model name="cylinder"><static>1</static><pose>-3.6 -2.3 0.3 0 0 0</pose><link name="link">
    <collision name="collision"><geometry><cylinder><radius>0.15</radius><length>0.6</length></cylinder></geometry></collision>
    <visual name="visual"><geometry><cylinder><radius>0.15</radius><length>0.6</length></cylinder></geometry>
      <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Blue</name></script></material></visual>
  </link></model>
</world></sdf>
