<?xml version="1.0"?>
<sdf version="1.6"><world name="flat">
    <light name="sun" type="directional"><cast_shadows>1</cast_shadows><pose>0 0 10 0 0 0</pose><diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular><direction>-0.5 0.5 -1</direction></light>
    <gravity>0 0 -9.8</gravity>
    <physics name="default_physics" default="0" type="ode"><max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor><real_time_update_rate>1000</real_time_update_rate></physics>
    <scene><ambient>0.45 0.45 0.45 1</ambient><background>0.7 0.78 0.9 1</background><shadows>1</shadows></scene>
<model name='ground_plane'>
      <static>1</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
              <torsional>
                <ode/>
              </torsional>
            </friction>
            <contact>
              <ode/>
            </contact>
            <bounce/>
          </surface>
          <max_contacts>10</max_contacts>
        </collision>
        <visual name='visual'>
          <cast_shadows>0</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/DarkGrey</name>
            </script>
          </material>
        </visual>
        <self_collide>0</self_collide>
        <kinematic>0</kinematic>
        <gravity>1</gravity>
      </link>
    </model>
    <model name="floor_grid"><static>1</static><link name="l"><visual name="gx0"><pose>-6.00 0 0.001 0 0 0</pose><geometry><box><size>0.03 10.0 0.002</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual><visual name="gx1"><pose>-5.00 0 0.001 0 0 0</pose><geometry><box><size>0.03 10.0 0.002</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual><visual name="gx2"><pose>-4.00 0 0.001 0 0 0</pose><geometry><box><size>0.03 10.0 0.002</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual><visual name="gx3"><pose>-3.00 0 0.001 0 0 0</pose><geometry><box><size>0.03 10.0 0.002</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual><visual name="gx4"><pose>-2.00 0 0.001 0 0 0</pose><geometry><box><size>0.03 10.0 0.002</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual><visual name="gx5"><pose>-1.00 0 0.001 0 0 0</pose><geometry><box><size>0.03 10.0 0.002</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual><visual name="gx6"><pose>0.00 0 0.001 0 0 0</pose><geometry><box><size>0.03 10.0 0.002</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual><visual name="gx7"><pose>1.00 0 0.001 0 0 0</pose><geometry><box><size>0.03 10.0 0.002</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual><visual name="gx8"><pose>2.00 0 0.001 0 0 0</pose><geometry><box><size>0.03 10.0 0.002</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual><visual name="gx9"><pose>3.00 0 0.001 0 0 0</pose><geometry><box><size>0.03 10.0 0.002</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual><visual name="gx10"><pose>4.00 0 0.001 0 0 0</pose><geometry><box><size>0.03 10.0 0.002</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual><visual name="gx11"><pose>5.00 0 0.001 0 0 0</pose><geometry><box><size>0.03 10.0 0.002</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual><visual name="gx12"><pose>6.00 0 0.001 0 0 0</pose><geometry><box><size>0.03 10.0 0.002</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual><visual name="gy0"><pose>0 -5.00 0.001 0 0 0</pose><geometry><box><size>12.0 0.03 0.002</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual><visual name="gy1"><pose>0 -4.00 0.001 0 0 0</pose><geometry><box><size>12.0 0.03 0.002</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual><visual name="gy2"><pose>0 -3.00 0.001 0 0 0</pose><geometry><box><size>12.0 0.03 0.002</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual><visual name="gy3"><pose>0 -2.00 0.001 0 0 0</pose><geometry><box><size>12.0 0.03 0.002</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual><visual name="gy4"><pose>0 -1.00 0.001 0 0 0</pose><geometry><box><size>12.0 0.03 0.002</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual><visual name="gy5"><pose>0 0.00 0.001 0 0 0</pose><geometry><box><size>12.0 0.03 0.002</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual><visual name="gy6"><pose>0 1.00 0.001 0 0 0</pose><geometry><box><size>12.0 0.03 0.002</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual><visual name="gy7"><pose>0 2.00 0.001 0 0 0</pose><geometry><box><size>12.0 0.03 0.002</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual><visual name="gy8"><pose>0 3.00 0.001 0 0 0</pose><geometry><box><size>12.0 0.03 0.002</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual><visual name="gy9"><pose>0 4.00 0.001 0 0 0</pose><geometry><box><size>12.0 0.03 0.002</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual><visual name="gy10"><pose>0 5.00 0.001 0 0 0</pose><geometry><box><size>12.0 0.03 0.002</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual></link></model>
    <model name="marker_A"><static>1</static><pose>-4.5 -3.5 0.01 0 0 0</pose><link name="l">
      <visual name="v"><geometry><cylinder><radius>0.4</radius><length>0.02</length></cylinder></geometry>
      <material><ambient>0.1 0.8 0.2 1</ambient><diffuse>0.1 0.8 0.2 1</diffuse><emissive>0.1 0.8 0.2 1</emissive></material></visual></link></model>
    <!-- side camera on marker A, 1.6 m to the robot's right, for the walk-in-place video (4.03): /side/cam/image_raw -->
    <model name="side"><static>1</static><pose>-4.5 -5.1 0.32 0 0.08 1.571</pose><link name="l">
      <sensor name="side_sensor" type="camera"><always_on>1</always_on><update_rate>20</update_rate>
        <camera><horizontal_fov>0.9</horizontal_fov><image><width>960</width><height>540</height><format>R8G8B8</format></image>
        <clip><near>0.1</near><far>20</far></clip></camera>
        <plugin name="side_plugin" filename="libgazebo_ros_camera.so"><ros><namespace>side</namespace></ros>
        <camera_name>cam</camera_name><frame_name>side_optical</frame_name></plugin></sensor></link></model>
    <!-- gazebo_ros_state: /gazebo/link_states (true link poses, used to score foot height) and /gazebo/get_entity_state -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so"><ros><namespace>/gazebo</namespace></ros><update_rate>100</update_rate></plugin>
</world></sdf>
